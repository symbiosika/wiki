{
  "permissions": {
    "ask": [
      "Edit(./backend/framework/**)",
      "Write(./backend/framework/**)"
    ],
    "allow": [
      "Bash(docker compose *)",
      "Bash(bun run *)",
      "Bash(bunx *)",
      "Bash(bun install*)",
      "Bash(bun test*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
