# Example environment for docker-compose.prod.yml
# Copy to `.env` and fill in the values. Never commit the real .env.

# --- Compose / image ---
# PROJECT_NAME=wiki
# REGISTRY=symbiosika.azurecr.io
# IMAGE_TAG=latest
# APP_PORT=3000

# --- Logging ---
# app.log is only written when this is true (rotation: 10 files x 1MB).
WRITE_DEBUG_FILES=true
CRON_LOG=true

# --- Operations log / Bad Gateway diagnostics ---
# One NDJSON line per operational event, prefixed `[ops]` on stdout and (unless
# OPS_LOG_FILE=false) appended to logs/ops.log. Covers boots, crashes with the
# reason, a 30s heartbeat (memory vs. container limit, event loop lag, in-flight
# requests) and every slow or failed request. Runbook:
# docs/bad-gateway-debugging.md
OPS_LOG=true
OPS_LOG_FILE=true
# Heartbeat interval in ms; 0 disables it.
OPS_HEARTBEAT_MS=30000
# A request taking at least this long is logged as slow.
OPS_SLOW_REQUEST_MS=3000
# Log *every* request, not just the notable ones. Only while debugging.
OPS_LOG_ALL_REQUESTS=false
# Enables GET /internal/diagnostics (live snapshot; works even while the DB is
# down). Pass the value as X-Diagnostics-Token or ?token=. Leave empty to keep
# the path non-existent.
DIAGNOSTICS_TOKEN=

# --- URL / CORS ---
BASE_URL=https://wiki.example.com
ALLOWED_ORIGINS=https://wiki.example.com

# --- Database (host defaults to the `postgres` service) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=wiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wiki
POSTGRES_CONNECTION_POOL_SIZE=10

# --- Encryption / JWT (generate with `bun run init` in backend/) ---
SECRETS_AES_KEY=
SECRETS_AES_IV=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_DEFAULT_SENDER=noreply@example.com

# --- Microsoft 365 login + Teams app (optional, see docs/teams-app.md) ---
# With both values set, the login page offers "sign in with Microsoft 365", and
# the same app registration powers the Microsoft Teams tab (which needs no
# secret — it only validates the token the Teams host hands it).
# Redirect URI to register in Entra ID:
#   ${BASE_URL}/api/v1/user/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Directory to authenticate against: tenant GUID (single organisation),
# `organizations`, or `common` (default, any Microsoft account). Set the GUID for
# a Teams rollout — otherwise any Microsoft 365 user worldwide reaches the
# invitation-code step.
MICROSOFT_TENANT_ID=

# --- AI / Transcription (optional, see README) ---
OPENROUTER_API_KEY=
# OpenRouter model id used for all text LLM / agent calls (default: mistralai/mistral-large)
OPENROUTER_MODEL=mistralai/mistral-large
MISTRAL_API_KEY=

# --- MCP server (embedded in the app, served at ${BASE_URL}/mcp) ---
# The former standalone MCP server now runs inside the app process; point the
# old MCP domain at the app (redirect) and clients keep working unchanged.
# Shared secret that keeps /oauth/introspect available for EXTERNAL resource
# servers (the embedded MCP server validates tokens in-process without it).
OAUTH_INTROSPECTION_SECRET=
# Optional fallback organisation id for credentials without a tenant binding.
# Leave empty on multi-tenant deployments.
WIKI_TENANT_ID=
