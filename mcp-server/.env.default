# ── Symbiosika Wiki MCP server (OAuth2 resource server) ──────────────────────

# Port this MCP server listens on.
MCP_PORT=8787

# Public, canonical URL of THIS server = token audience.
# ORIGIN ONLY, NO /mcp suffix. Prod: https://mcp.your-domain.tld
MCP_PUBLIC_URL=http://localhost:8787

# Base URL of the wiki app (authorization server = the backend).
# Locally the dev API (port 3000), in prod the public HTTPS URL.
# This is the PUBLIC issuer: it appears in the resource metadata and is the
# accepted token audience/issuer — clients must reach it too.
OAUTH_ISSUER=http://localhost:3000

# Base URL for the server-to-server introspection call ONLY. Defaults to
# OAUTH_ISSUER. Set this when the public issuer URL is not routable from
# inside this container — e.g. both services share a docker-compose network:
# point it at the backend's internal service name so introspection stays on
# the internal network instead of hairpinning out through the reverse proxy.
# Symptom of the missing/unreachable value: `/mcp` returns 401 fast WITHOUT a
# token but hangs into a 504 WITH one. Must hit the same backend as OAUTH_ISSUER.
# Example (docker compose):  OAUTH_INTROSPECTION_URL=http://backend:3000
# OAUTH_INTROSPECTION_URL=

# Timeout (ms) for the introspection call. Default 5000. A hung backend fails
# fast with a logged 401 instead of stalling until the proxy 504s.
# OAUTH_INTROSPECTION_TIMEOUT_MS=5000

# Shared secret for token introspection — pulled from the backend's
# OAUTH_INTROSPECTION_SECRET by `bun run init`. Must match exactly.
# OAUTH_INTROSPECTION_SECRET=

# Optional fallback for the organisation (tenant) id, used only if a validated
# token carries no `tenant` field. Leave empty when tokens are tenant-bound.
WIKI_TENANT_ID=
