name: Build and push Docker images

on:
  push:
    branches:
      - main
  workflow_dispatch:

env:
  REGISTRY: my-great-registry.azurecr.io
  COOLIFY_BASE_URL: https://my-coolify.my-domain.com
  COOLIFY_UUID: kj7g...

jobs:

  # ---------------------------------------------------------------------------
  # FRONTEND – build static assets for the main app image
  # ---------------------------------------------------------------------------
  build-frontend:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          ref: main
          bun-version: latest

      - name: Install dependencies
        working-directory: frontend
        run: bun install

      - name: Build frontend
        working-directory: frontend
        run: bun run build

      - name: Upload frontend artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ github.event.repository.name }}-${{ github.ref_name }}-frontend
          path: frontend/dist
          retention-days: 1

  # ---------------------------------------------------------------------------
  # BACKEND – bundle backend + copy migrations/config for the main app image
  # ---------------------------------------------------------------------------
  build-backend:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: main
          submodules: recursive
          fetch-depth: 2

      - name: Setup Bun
        uses: oven-sh/setup-bun@v2
        with:
          bun-version: latest

      - name: Install dependencies
        working-directory: backend
        run: bun install

      - name: Build backend
        working-directory: backend
        run: bun run build

      - name: Prepare artifact
        working-directory: backend
        run: |
          mkdir -p backend-artifact/dist
          mkdir -p backend-artifact/static
          mkdir -p backend-artifact/public
          mkdir -p backend-artifact/drizzle-sql
          mkdir -p backend-artifact/framework/drizzle-sql
          mkdir -p backend-artifact/src/db

          cp -r dist/* backend-artifact/dist/
          cp -r static/* backend-artifact/static/ 2>/dev/null || true
          cp -r public/* backend-artifact/public/ 2>/dev/null || true

          cp drizzle.config.ts backend-artifact/
          cp -r drizzle-sql/* backend-artifact/drizzle-sql/
          cp framework/drizzle.config.ts backend-artifact/framework/
          cp -r framework/drizzle-sql/* backend-artifact/framework/drizzle-sql/

          cp -r src/db/* backend-artifact/src/db/

          cp package.json backend-artifact/

      - name: Upload backend artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ github.event.repository.name }}-${{ github.ref_name }}-backend
          path: backend/backend-artifact
          retention-days: 1

  # ---------------------------------------------------------------------------
  # MAIN APP IMAGE – backend + bundled frontend
  # ---------------------------------------------------------------------------
  build-docker-app:
    needs: [build-backend, build-frontend]
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Download backend artifact
        uses: actions/download-artifact@v4
        with:
          name: ${{ github.event.repository.name }}-${{ github.ref_name }}-backend
          path: dist

      - name: Download frontend artifact
        uses: actions/download-artifact@v4
        with:
          name: ${{ github.event.repository.name }}-${{ github.ref_name }}-frontend
          path: frontend_artifact

      - name: Merge frontend into dist
        run: |
          mkdir -p dist/static
          cp -r frontend_artifact/static/* dist/static/

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to Ionos Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.MY_DOCKER_REGISTRY_USER }}
          password: ${{ secrets.MY_DOCKER_REGISTRY_PASSWORD }}

      - name: Build and push main app image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: ./Dockerfile
          push: true
          tags: |
            ${{ env.REGISTRY }}/${{ github.event.repository.name }}:latest
            ${{ env.REGISTRY }}/${{ github.event.repository.name }}:${{ github.sha }}
          cache-from: type=gha,scope=${{ github.event.repository.name }}
          cache-to: type=gha,mode=max,scope=${{ github.event.repository.name }}

  # ---------------------------------------------------------------------------
  # COOLIFY DEPLOY TRIGGERS
  # runs only after its image has been pushed successfully.
  # ---------------------------------------------------------------------------
  deploy-app:
    needs: build-docker-app
    runs-on: ubuntu-latest
    steps:
      - name: Trigger Coolify deploy
        env:
          COOLIFY_TOKEN: ${{ secrets.COOLIFY_DEPLOY_TOKEN }}
          COOLIFY_UUID: ${{ env.COOLIFY_UUID }}
        continue-on-error: true
        run: |
          curl -sS -X GET \
            --max-time 2 --retry 2 --retry-all-errors \
            -H "Authorization: Bearer ${COOLIFY_TOKEN}" \
            "${COOLIFY_BASE_URL}/api/v1/deploy?uuid=${COOLIFY_UUID}&force=false" \
            || true
