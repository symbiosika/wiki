# App-specific required variables, applied by `bun run init`.
#
# VALUE syntax: {shared_secret} generates a secret; {user_input} prompts;
# {!} forces overwrite; {folder://PATH:SRC} copies from another service's .env.

# Public base URL of the app = OAuth2 issuer (used in OAuth metadata + JWT iss).
BASE_URL=http://localhost:3000

# Shared secret for OAuth2 token introspection (RFC 7662). The standalone MCP
# resource server (../mcp-server) pulls this exact value into its own .env.
OAUTH_INTROSPECTION_SECRET={shared_secret}

# Display name of the app, used in emails (login link, invites, …) and OAuth
# metadata. Optional — defaults to "Symbiosika Wiki" when unset. Set a shorter
# label here (e.g. "Wiki") to override it everywhere.
# APP_NAME=Wiki

# Public documentation site (/docs) and its unauthenticated API. Optional —
# defaults to on. Publishing is already opt-in per page, so nothing is exposed
# until someone marks a page public; set this to false to make that impossible
# on this instance regardless of what is configured in the admin UI. Off means
# the API routes are not registered and /docs stops answering; the login pages
# in ./public are unaffected. An unrecognised value fails startup rather than
# quietly defaulting to on.
# PUBLIC_WIKI_ENABLED=false
