# App-specific required variables, applied by `bun run init`.
#
# VALUE syntax: {shared_secret} generates a secret; {user_input} prompts;
# {!} forces overwrite; {folder://PATH:SRC} copies from another service's .env.

# Public base URL of the app = OAuth2 issuer (used in OAuth metadata + JWT iss).
BASE_URL=http://localhost:3000

# Shared secret for OAuth2 token introspection (RFC 7662). The standalone MCP
# resource server (../mcp-server) pulls this exact value into its own .env.
OAUTH_INTROSPECTION_SECRET={shared_secret}
